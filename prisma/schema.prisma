generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FotoTipo {
  CLIENTE
  JUANSER
}

enum ArchivoClienteTipo {
  IMAGEN
  VIDEO
}

enum TrabajoMediaTipo {
  IMAGEN
  VIDEO
}

enum TrabajoMediaCategoria {
  ANTES
  DESPUES
  VIDEO
}

enum PresupuestoEstado {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  INSTALADO
}

enum EstadoCobroFacturaVenta {
  PENDIENTE
  PARCIAL
  COBRADA
}

enum MetodoPago {
  Transferencia
  Efectivo
  Tarjeta
  Bizum
  Otro
}

enum CitaOrigen {
  AMELIA
  MANUAL
}

enum CitaEstado {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  REALIZADA
}

enum ActividadClienteTipo {
  CLIENTE_CREADO
  ESTADO_CAMBIADO
  PRESUPUESTO_CREADO
  PRESUPUESTO_EDITADO
  PRESUPUESTO_ELIMINADO
  PAGO_CUENTA_REGISTRADO
  PAGO_CUENTA_ELIMINADO
  SEGUIMIENTO_CREADO
  IMAGEN_CLIENTE_SUBIDA
  IMAGEN_JUANSER_SUBIDA
  CLIENTE_CONVERTIDO_TRABAJO
}

model Cliente {
  id               Int                @id @default(autoincrement())
  nombre           String
  telefono         String?
  email            String?
  direccion        String?
  localidad        String?
  tipoTrabajo      String?
  origenContacto   String?
  tipoCliente      String?
  motivoRechazo    String?
  fechaMedicion    DateTime?
  fechaInstalacion DateTime?
  importeAceptado  Decimal?           @db.Decimal(12, 2)
  presupuesto      Decimal?           @db.Decimal(12, 2)
  fechaAlta        DateTime           @default(now())
  fechaSeguimiento DateTime?
  observaciones    String?
  estado           String             @default("PENDIENTE_DAR_PRECIO")
  estadoProduccion String             @default("NO_APLICA")
  seguimientos     Seguimiento[]
  fotos            FotoCliente[]
  presupuestos     Presupuesto[]
  pagosCuenta      PagoCuenta[]
  actividades      ActividadCliente[]
  facturasVenta    FacturaVenta[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([estado])
  @@index([estadoProduccion])
}

model Seguimiento {
  id        Int      @id @default(autoincrement())
  clienteId Int
  fecha     DateTime @default(now())
  nota      String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model FotoCliente {
  id            Int                @id @default(autoincrement())
  clienteId     Int
  tipo          FotoTipo
  url           String
  nombreArchivo String
  descripcion   String?
  mimeType      String?
  tamanoBytes   Int                @default(0)
  tipoArchivo   ArchivoClienteTipo @default(IMAGEN)
  createdAt     DateTime           @default(now())
  cliente       Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([tipo])
  @@index([tipoArchivo])
}

model Presupuesto {
  id                   Int                        @id @default(autoincrement())
  clienteId            Int
  numero               String                     @unique
  titulo               String
  descripcion          String
  importe              Decimal                    @db.Decimal(12, 2)
  estado               PresupuestoEstado          @default(PENDIENTE)
  fecha                DateTime                   @default(now())
  validezDias          Int                        @default(30)
  observaciones        String?
  ivaPorcentaje        Decimal                    @default(21) @db.Decimal(5, 2)
  totalSinIva          Decimal                    @default(0) @db.Decimal(12, 2)
  totalIva             Decimal                    @default(0) @db.Decimal(12, 2)
  totalConIva          Decimal                    @default(0) @db.Decimal(12, 2)
  costeHorasEstimadas  Decimal                    @default(0) @db.Decimal(10, 2)
  costeHora            Decimal                    @default(0) @db.Decimal(10, 2)
  costeTransporte      Decimal                    @default(0) @db.Decimal(12, 2)
  costeMontaje         Decimal                    @default(0) @db.Decimal(12, 2)
  publicToken          String?                    @unique
  publicTokenCreatedAt DateTime?
  lineas               PresupuestoLinea[]
  costesMateriales     PresupuestoCosteMaterial[]
  otrosCostes          PresupuestoCosteOtro[]
  pagosCuenta          PagoCuenta[]
  facturasVenta        FacturaVenta[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  cliente              Cliente                    @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([estado])
}

model FacturaVenta {
  id            Int                     @id @default(autoincrement())
  clienteId     Int
  presupuestoId Int?
  numeroFactura String
  fechaFactura  DateTime
  baseImponible Decimal                 @db.Decimal(12, 2)
  iva           Decimal                 @db.Decimal(12, 2)
  total         Decimal                 @db.Decimal(12, 2)
  estadoCobro   EstadoCobroFacturaVenta @default(PENDIENTE)
  notas         String?
  archivoUrl    String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  cliente       Cliente                 @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  presupuesto   Presupuesto?            @relation(fields: [presupuestoId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([presupuestoId])
  @@index([numeroFactura])
  @@index([fechaFactura])
  @@index([estadoCobro])
}

model PresupuestoCosteMaterial {
  id            Int         @id @default(autoincrement())
  presupuestoId Int
  materialId    String?
  descripcion   String
  cantidad      Decimal     @default(1) @db.Decimal(10, 2)
  precioCoste   Decimal     @default(0) @db.Decimal(12, 2)
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  material      Material?   @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([presupuestoId])
  @@index([materialId])
}

model PresupuestoCosteOtro {
  id            Int         @id @default(autoincrement())
  presupuestoId Int
  descripcion   String
  importe       Decimal     @default(0) @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@index([presupuestoId])
}

model PresupuestoLinea {
  id             Int         @id @default(autoincrement())
  presupuestoId  Int
  concepto       String
  descripcion    String?
  cantidad       Decimal     @db.Decimal(10, 2)
  precioUnitario Decimal     @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@index([presupuestoId])
}

model PagoCuenta {
  id            Int          @id @default(autoincrement())
  clienteId     Int
  presupuestoId Int?
  concepto      String
  importe       Decimal      @db.Decimal(12, 2)
  fechaPago     DateTime
  metodoPago    MetodoPago
  referencia    String?
  observaciones String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  cliente       Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  presupuesto   Presupuesto? @relation(fields: [presupuestoId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([presupuestoId])
  @@index([fechaPago])
}

model ActividadCliente {
  id          Int                  @id @default(autoincrement())
  clienteId   Int
  fecha       DateTime             @default(now())
  tipo        ActividadClienteTipo
  descripcion String
  usuario     String?
  createdAt   DateTime             @default(now())
  cliente     Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([fecha])
  @@index([tipo])
}

model Proveedor {
  id            Int                  @id @default(autoincrement())
  nombre        String
  codigoInterno String?              @unique
  telefono      String?
  email         String?
  web           String?
  categoria     String?
  contacto      String?
  direccion     String?
  observaciones String?
  documentos    DocumentoProveedor[]
  actividades   ActividadProveedor[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([nombre])
  @@index([categoria])
  @@index([contacto])
  @@index([telefono])
}

model DocumentoProveedor {
  id          Int       @id @default(autoincrement())
  proveedorId Int
  nombre      String
  tipo        String
  archivoUrl  String
  descripcion String?
  tamanoBytes Int
  createdAt   DateTime  @default(now())
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([proveedorId])
  @@index([tipo])
  @@index([nombre])
}

model ActividadProveedor {
  id          Int       @id @default(autoincrement())
  proveedorId Int
  fecha       DateTime  @default(now())
  descripcion String
  createdAt   DateTime  @default(now())
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([proveedorId])
  @@index([fecha])
}

model TitularGasto {
  id            Int      @id @default(autoincrement())
  codigoInterno String   @unique
  nombre        String
  nif           String?
  direccion     String?
  telefono      String?
  email         String?
  activo        Boolean  @default(true)
  gastos        Gasto[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nombre])
  @@index([activo])
}

model Gasto {
  id              String       @id @default(cuid())
  tipoGasto       String       @default("Otros")
  proveedor       String?
  fecha           DateTime?
  tipoDocumento   String?
  numeroInterno   String?      @unique
  numeroDocumento String?
  categoria       String?
  baseImponible   Decimal?     @db.Decimal(10, 2)
  iva             Decimal?     @db.Decimal(10, 2)
  total           Decimal?     @db.Decimal(10, 2)
  formaPago       String?
  descripcion     String?
  observaciones   String?
  archivoUrl      String?
  titularGastoId  Int?
  titularGasto    TitularGasto? @relation(fields: [titularGastoId], references: [id], onDelete: SetNull)
  lineas          GastoLinea[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([proveedor])
  @@index([tipoGasto])
  @@index([fecha])
  @@index([tipoDocumento])
  @@index([numeroInterno])
  @@index([categoria])
  @@index([titularGastoId])
}

model GastoLinea {
  id                      String    @id @default(cuid())
  gastoId                 String
  materialId              String?
  codigoMaterialDetectado String?
  descripcion             String
  cantidad                Decimal?  @db.Decimal(10, 2)
  precioUnitario          Decimal?  @db.Decimal(10, 2)
  unidadMedidaProveedor   String?
  piezas                  Decimal?  @db.Decimal(10, 2)
  medida                  Decimal?  @db.Decimal(10, 3)
  precioUnidadMedida      Decimal?  @db.Decimal(12, 5)
  descuentoPorcentaje     Decimal   @default(0) @db.Decimal(5, 2)
  importe                 Decimal?  @db.Decimal(10, 2)
  esPorte                 Boolean   @default(false)
  esPendienteServir       Boolean   @default(false)
  pedidoProveedor         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  gasto                   Gasto     @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  material                Material? @relation(fields: [materialId], references: [id])

  @@index([gastoId])
  @@index([materialId])
  @@index([codigoMaterialDetectado])
  @@index([descripcion])
  @@index([pedidoProveedor])
}

model DocumentoSecuencia {
  id            Int      @id @default(autoincrement())
  tipoDocumento String   @unique
  ultimoNumero  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Material {
  id          String   @id @default(cuid())
  codigo      String   @unique
  nombre      String
  categoria   String?
  unidadBase  String?
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineas            GastoLinea[]
  costesPresupuesto PresupuestoCosteMaterial[]

  @@index([nombre])
  @@index([categoria])
}

model Cita {
  id              Int        @id @default(autoincrement())
  clienteNombre   String
  telefono        String?
  email           String?
  fechaHora       DateTime
  origen          CitaOrigen @default(MANUAL)
  estado          CitaEstado @default(PENDIENTE)
  nota            String?
  ameliaBookingId String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([fechaHora])
  @@index([estado])
  @@index([origen])
}

model CalculoArmario {
  id                      Int      @id @default(autoincrement())
  fecha                   DateTime @default(now())
  anchoCm                 Decimal  @db.Decimal(10, 2)
  altoCm                  Decimal  @db.Decimal(10, 2)
  fondoCm                 Decimal  @db.Decimal(10, 2)
  tipoPuertas             String
  numeroPuertas           Int
  numeroModulos           Int
  numeroCajones           Int
  numeroBaldas            Int
  numeroBarras            Int
  tipoTrasera             String
  materialPrincipal       String
  grosorPrincipalMm       Int
  observaciones           String?
  metrosFrontales         Decimal  @db.Decimal(10, 3)
  metrosTableroPrincipal  Decimal  @db.Decimal(10, 3)
  tablerosPrincipales     Int
  metrosTrasera           Decimal  @db.Decimal(10, 3)
  tablerosTrasera         Int
  metrosCanto             Decimal  @db.Decimal(10, 2)
  bisagras                Int
  guiasCajon              Int
  metrosBarra             Decimal  @db.Decimal(10, 2)
  complejidad             String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([fecha])
  @@index([createdAt])
  @@index([tipoPuertas])
  @@index([complejidad])
}

model TrabajoTerminado {
  id            Int                     @id @default(autoincrement())
  titulo        String
  clienteNombre String?
  localidad     String
  tipoTrabajo   String
  descripcion   String
  importe       Decimal                 @db.Decimal(12, 2)
  fechaTrabajo  DateTime
  destacadoWeb  Boolean                 @default(false)
  media         TrabajoTerminadoMedia[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([localidad])
  @@index([tipoTrabajo])
  @@index([fechaTrabajo])
  @@index([destacadoWeb])
}

model TrabajoTerminadoMedia {
  id            Int                   @id @default(autoincrement())
  trabajoId     Int
  tipoArchivo   TrabajoMediaTipo
  categoria     TrabajoMediaCategoria @default(DESPUES)
  url           String
  nombreArchivo String
  descripcion   String?
  mimeType      String?
  tamanoBytes   Int                   @default(0)
  createdAt     DateTime              @default(now())
  trabajo       TrabajoTerminado      @relation(fields: [trabajoId], references: [id], onDelete: Cascade)

  @@index([trabajoId])
  @@index([tipoArchivo])
  @@index([categoria])
}
