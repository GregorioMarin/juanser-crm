generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FotoTipo {
  CLIENTE
  JUANSER
}

enum PresupuestoEstado {
  PENDIENTE
  ACEPTADO
  RECHAZADO
}

model Cliente {
  id               Int           @id @default(autoincrement())
  nombre           String
  telefono         String?
  email            String?
  direccion        String?
  localidad        String?
  tipoTrabajo      String?
  presupuesto      Decimal? @db.Decimal(12, 2)
  fechaAlta        DateTime @default(now())
  fechaSeguimiento DateTime?
  observaciones    String?
  estado           String        @default("Nuevo lead")
  seguimientos     Seguimiento[]
  fotos            FotoCliente[]
  presupuestos     Presupuesto[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Seguimiento {
  id        Int      @id @default(autoincrement())
  clienteId Int
  fecha     DateTime @default(now())
  nota      String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model FotoCliente {
  id            Int       @id @default(autoincrement())
  clienteId     Int
  tipo          FotoTipo
  url           String
  nombreArchivo String
  descripcion   String?
  createdAt     DateTime  @default(now())
  cliente       Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([tipo])
}

model Presupuesto {
  id             Int                 @id @default(autoincrement())
  clienteId      Int
  numero         String
  titulo         String
  descripcion    String
  importe        Decimal             @db.Decimal(12, 2)
  estado         PresupuestoEstado   @default(PENDIENTE)
  fecha          DateTime            @default(now())
  validezDias    Int                 @default(15)
  observaciones  String?
  ivaPorcentaje  Decimal             @default(21) @db.Decimal(5, 2)
  totalSinIva    Decimal             @default(0) @db.Decimal(12, 2)
  totalIva       Decimal             @default(0) @db.Decimal(12, 2)
  totalConIva    Decimal             @default(0) @db.Decimal(12, 2)
  lineas         PresupuestoLinea[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  cliente        Cliente             @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([estado])
}

model PresupuestoLinea {
  id             Int         @id @default(autoincrement())
  presupuestoId  Int
  concepto       String
  descripcion    String?
  cantidad       Decimal     @db.Decimal(10, 2)
  precioUnitario Decimal     @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@index([presupuestoId])
}
